<div class="image">
    <div class="image__header">
        <a class="image__link" href="#" >
            <img class="image__photo @(SameSize ? "sameSize" : "")" src="@ImageModel.Image" alt="photo" />
        </a>
        <div class="image__content">
            <a href="#" class="image__author">
                <img class="image__avatar" src=@Assets["icons/account.svg"] alt="user avatar" />
                <span class="image__nickname">@ImageModel.Author</span>
            </a>
            <div class="image__stats">
                <span class="image__icon image__icon--like"></span>
                <span class="image__icon image__icon--add"></span>
            </div>
        </div>
    </div>
</div>
